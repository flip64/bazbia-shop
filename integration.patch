+    )
+
+    can_retry = serializers.SerializerMethodField()
+
+    class Meta:
+        model = Payment
+
+        fields = [
+            "requires_review",
+            "id",
+            "order",
+            "order_status",
+            "amount",
+            "payment_method",
+            "payment_method_display",
+            "status",
